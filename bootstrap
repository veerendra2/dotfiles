#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(dirname -- "$( readlink -f -- "$0"; )";)"
TARGET_DIR="${HOME}/projects/dotfiles"
BRANCH="main"
REPO_HTTPS="https://github.com/veerendra2/dotfiles.git"
REPO_SSH="git@github.com:veerendra2/dotfiles.git"

# Ask which Homebrew install to use (no sudo required for local)
install_homebrew() {
  if command -v brew >/dev/null 2>&1; then
    return
  fi

  local answer
  while true; do
    echo ""
    read -r -p "[?] Install Homebrew as: [1] Standard (system-wide)  [2] Local (~/.local/Homebrew)  choice: " answer
    case "$answer" in
      1)
        echo "[*] Installing standard Homebrew..."
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [ -x /opt/homebrew/bin/brew ]; then
          eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -x /usr/local/bin/brew ]; then
          eval "$(/usr/local/bin/brew shellenv)"
        fi
        break
        ;;
      2)
        echo "[*] Installing Homebrew locally..."
        mkdir -p "$HOME/.local/Homebrew"
        if ! curl -fsSL https://github.com/Homebrew/brew/tarball/main | tar xz --strip-components 1 -C "$HOME/.local/Homebrew"; then
          echo "[!] Failed to download or extract Homebrew"
          return 1
        fi
        eval "$("$HOME/.local/Homebrew/bin/brew" shellenv)"
        "$HOME/.local/Homebrew/bin/brew" update --force --quiet
        export LOCAL_HOMEBREW=1
        echo "[+] Local Homebrew installed at ~/.local/Homebrew"
        echo "[!] Add 'export LOCAL_HOMEBREW=1' to shell/common/.extra for future sessions"
        break
        ;;
      *)
        echo "[!] Please enter 1 or 2"
        ;;
    esac
  done
}

if [ "$(uname -s)" = "Darwin" ]; then
  if ! xcode-select -p >/dev/null 2>&1; then
    echo "[!] Xcode Command Line Tools not installed."
    echo "[!] Run: xcode-select --install"
    echo "[!] Once the install finishes, re-run this bootstrap script."
    exit 1
  fi

  install_homebrew

  # A brand-new macOS install has no git; get it from the Homebrew we just set up
  if ! command -v git >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
    echo "[*] Installing git..."
    brew install git
  fi
elif [ "$(uname -s)" = "Linux" ] && ! command -v git >/dev/null 2>&1; then
  echo "[*] Installing git..."
  sudo apt-get update && sudo apt-get install -y git
fi

# Check if running standalone (e.g. via curl | bash), clone/update the repo first
if [ ! -d "${ROOT_DIR}/linux" ] && [ ! -d "${ROOT_DIR}/macos" ]; then
  echo "[*] Bootstrapping: Creating directory infrastructure..."
  mkdir -p "${HOME}/projects"

  if [ ! -d "$TARGET_DIR" ]; then
    echo "[*] Cloning dotfiles repository..."
    git clone --branch "$BRANCH" "$REPO_HTTPS" "$TARGET_DIR"
    # Switch to SSH for future pulls/pushes; works even before an SSH key is set up
    git -C "$TARGET_DIR" remote set-url origin "$REPO_SSH"
  elif git -C "$TARGET_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "[*] Repository exists. Updating via git..."
    git -C "$TARGET_DIR" pull || echo "[!] git pull failed (SSH key not added to GitHub yet?) - continuing with existing copy"
  else
    echo "[*] Repository exists but isn't a git checkout. Using existing copy..."
  fi

  exec "$TARGET_DIR/bootstrap" "$@"
fi

mkdir -p "${HOME}"/{projects,.config,.ssh/config.d}
chmod 700 "${HOME}/.ssh"

curl -fsSL https://github.com/veerendra2.keys >> "${HOME}/.ssh/authorized_keys"
chmod 600 "${HOME}/.ssh/authorized_keys"

if command -v ssh-keyscan >/dev/null 2>&1; then
  ssh-keyscan github.com gitlab.com >> "${HOME}/.ssh/known_hosts" 2>/dev/null || true
fi

if [ "$(uname -s)" = "Darwin" ]; then
  echo "[*] Running macOS installation..."
  "${ROOT_DIR}/macos/install.sh"

elif [ "$(uname -s)" = "Linux" ]; then
  echo "$(whoami) ALL=(ALL) NOPASSWD:ALL" | sudo tee "/etc/sudoers.d/custom" >/dev/null
  sudo chmod 0440 "/etc/sudoers.d/custom"

  echo "[*] Running Linux installation..."
  "${ROOT_DIR}/linux/install.sh"

else
  echo "Error: Unsupported OS" >&2
  exit 1
fi

if command -v symlinkr >/dev/null 2>&1; then
  echo "[*] Applying dotfiles symlinks via symlinkr..."
  symlinkr --config "${ROOT_DIR}/symlinkr.yaml" -f
  echo "[+] Dotfiles symlinked successfully!"
else
  echo "[!] symlinkr not found. Run 'symlinkr --config ${ROOT_DIR}/symlinkr.yaml' manually after installation." >&2
fi

if command -v mise >/dev/null 2>&1; then
  echo "[*] Installing mise-managed runtimes..."
  mise settings experimental=true
  mise install
  echo "[+] All global tools installed successfully!"
else
  echo "[!] mise not found. Install global tools manually after installation." >&2
fi

# SSH key setup
if [ ! -f "${HOME}/.ssh/id_ed25519" ] && [ ! -f "${HOME}/.ssh/id_rsa" ]; then
  echo "[*] Generating SSH key..."
  ssh-keygen -t ed25519 -C "$(whoami)@$(hostname)" -f "${HOME}/.ssh/id_ed25519" -N ""

  echo ""
  echo "[!] SSH key generated. Add your public key to GitHub:"
  echo "    https://github.com/settings/ssh/new"
  echo ""
  echo "Copy your public key with:"
  if [ "$(uname -s)" = "Darwin" ]; then
    echo "    cat ~/.ssh/id_ed25519.pub | pbcopy"
  else
    echo "    cat ~/.ssh/id_ed25519.pub"
  fi
  echo ""
fi
